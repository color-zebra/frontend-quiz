{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Файл вопросов одной подтемы",
  "type": "object",
  "additionalProperties": false,
  "required": ["topic", "subtopic", "questions"],
  "properties": {
    "topic": { "type": "string", "description": "id темы из topics.yaml, например html" },
    "subtopic": { "type": "string", "description": "id подтемы из topics.yaml, например forms" },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/question" }
    }
  },
  "definitions": {
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "level", "question", "options", "explanation"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z]+-[a-z0-9]+(-[a-z0-9]+)*-[0-9]{3}$",
          "description": "<topic>-<subtopic>-NNN. Никогда не менять и не переиспользовать: к id привязан прогресс в приложении"
        },
        "level": { "enum": ["junior", "middle", "senior"] },
        "tags": { "type": "array", "items": { "type": "string" } },
        "question": { "type": "string", "description": "Текст вопроса, Markdown" },
        "code": { "type": "string", "description": "Код к вопросу, без Markdown-обёртки" },
        "codeLang": { "enum": ["html", "css", "scss", "js", "ts", "jsx", "tsx", "http", "json", "text"] },
        "options": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "$ref": "#/definitions/option" }
        },
        "explanation": { "type": "string", "description": "Как это устроено, Markdown" },
        "links": { "type": "array", "items": { "type": "string", "format": "uri" } },
        "source": { "type": "string", "description": "own или <репозиторий>#<номер>" }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "why"],
      "properties": {
        "text": { "type": "string", "description": "Текст варианта, Markdown" },
        "correct": { "const": true, "description": "Только у правильного варианта" },
        "why": { "type": "string", "description": "Почему вариант верен или неверен, Markdown" }
      }
    }
  }
}
